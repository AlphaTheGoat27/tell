rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Read and delete: document must already belong to the authenticated user.
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.user_id;

      // Create: document doesn't exist yet, so check the incoming payload.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.user_id;

      // Update: verify ownership of both the existing doc and the new payload.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.user_id
        && request.auth.uid == request.resource.data.user_id;
    }
  }
}
