# Copy to backend/.env and fill in. Values here are read at API startup.
# Real environment variables always override this file.

# Turns on Cloud Firestore: hands, mastery, and action history persist across
# server restarts and devices. Without it the API uses in-memory storage and
# the History tab only shows hands from the current backend session.
GOOGLE_CLOUD_PROJECT=tell-506715

# Credentials for Firestore + token verification, pick ONE:
#   1. Application Default Credentials (easiest for local dev):
#        gcloud auth application-default login
#      (nothing to set here)
#   2. A service-account key file:
# FIREBASE_SERVICE_ACCOUNT=C:/path/to/service-account.json

# Optional dev override: "local" keeps `local:` demo tokens working even when
# this machine has stray Application Default Credentials.
# TELL_AUTH_MODE=local
