# Copy this file to .env.local and fill in the values from
# Firebase console -> Project settings -> General -> Your apps.
# With these set, "Sign in with Google" is enabled and the app stores the
# user's hands + leak/mastery memory in Cloud Firestore under their uid.
# Without them, Tell runs in local demo mode (in-memory storage, no sign-in).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the frontend at a non-default backend (defaults to /api,
# which the Vite dev server proxies to http://127.0.0.1:8000).
# VITE_API_BASE_URL=/api
